# NovelAudio v1 gateway
NOVEL_AUDIO_HOST=127.0.0.1
NOVEL_AUDIO_ALLOW_LAN=false
NOVEL_AUDIO_PORT=8788
NOVEL_AUDIO_TOKEN=generate-a-long-random-local-token
NOVEL_AUDIO_VOICE_REGISTRY=novel-audio-voicestudio.local.voices.json

# VoiceStudio Local API
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900
VOICESTUDIO_TOKEN=voice-studio-api-key
VOICESTUDIO_ALLOW_REMOTE=false
VOICESTUDIO_PROFILE=voicestudio-local-v1
VOICESTUDIO_PROFILE_REVISION=1
VOICESTUDIO_MODEL=tts-1
VOICESTUDIO_RESPONSE_FORMAT=wav
VOICESTUDIO_SPEECH_PATH=/v1/audio/speech
FFMPEG_PATH=ffmpeg

# Optional chapter director; empty means chapter analysis is not ready.
DIRECTOR_BASE_URL=
DIRECTOR_TOKEN=
